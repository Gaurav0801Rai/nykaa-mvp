# Groq API keys — three separate keys, one per task, so a rate limit on one
# feature cannot starve another. Read server-side only, inside /api routes.
# NEVER prefix these with VITE_ — that would ship them to the browser.
#
# Local development: copy this file to .env.local and run `vercel dev`.
# Production: set the same three in the Vercel project's Environment Variables.
#
# Every route falls back to a deterministic, rule-based path when a key is
# missing or rate-limited, so the app works end to end with none of these set.

# Confidence Score reason lines (wishlist, product detail, breakdown sheet)
GROQ_API_KEY_CONFIDENCE=

# Occasion inference (wishlist save, collections screen)
GROQ_API_KEY_OCCASION=

# Cross-sell pairing for the bag strip
GROQ_API_KEY_CROSSSELL=

# Optional — defaults to openai/gpt-oss-120b.
# Groq retired the llama-3.x-versatile ids; check /v1/models for what is live.
# GROQ_MODEL=openai/gpt-oss-120b
